{
  "version": 8,
  "name": "AncientData — Day (sage)",
  "metadata": {
    "description": "Minimal sage basemap for AncientData. Vector tiles: OpenFreeMap (OpenMapTiles schema). Flat by design: no basemap relief, so the project DEMs are never obscured.",
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#B2BA94"
      }
    },
    {
      "id": "landcover-grassland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "grass"
        ],
        [
          "!",
          [
            "match",
            [
              "get",
              "subclass"
            ],
            [
              "heath",
              "scrub"
            ],
            true,
            false
          ]
        ]
      ],
      "paint": {
        "fill-color": "#BCC39F",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0,
          11,
          0.9
        ]
      }
    },
    {
      "id": "landcover-heath",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
