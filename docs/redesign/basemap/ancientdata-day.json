        ],
        [
          "==",
          [
            "get",
            "subclass"
          ],
          "heath"
        ]
      ],
      "paint": {
        "fill-color": "#AAA487",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0,
          11,
          0.9
        ]
      }
    },
    {
