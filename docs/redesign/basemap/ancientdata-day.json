          ],
          9,
          0,
          11,
          0.9
        ]
      }
    },
    {
      "id": "landuse-built-up",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "residential",
          "commercial",
          "industrial",
          "retail"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#BBBDA5",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0,
          11,
