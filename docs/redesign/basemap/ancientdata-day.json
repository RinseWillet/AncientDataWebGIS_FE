    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          "#C6CCAF",
          13,
          "#E2E5D3",
          15,
          "#F2F3EA"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.5,
          12,
          1.6,
          16,
          4
        ]
      }
    },
    {
      "id": "label-river",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "river"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 13,
        "text-letter-spacing": 0.1,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "#3F5E68",
        "text-halo-color": "#B2BA94",
        "text-halo-width": 1.2
      }
    },
    {
