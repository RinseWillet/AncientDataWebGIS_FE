{
  "version": 8,
  "name": "AncientData — Hercules (phosphor green)",
  "metadata": {
    "description": "Monochrome basemap for the Hercules view. Terrain is shown only as contours from the project DEMs (separate 'contours' source). Forests are hatched via a runtime image 'hatch' (see hercules/contours-and-hatching.md). Colour is replaced by brightness and line style.",
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "contours": {
      "type": "vector",
      "tiles": [
        "__CONTOURS_TILE_URL__/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 9,
      "maxzoom": 14,
      "attribution": "Contours derived from project DEMs"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#040904"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ],
      "paint": {
        "fill-pattern": "hatch",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0,
          11,
          1
        ]
      }
    },
    {
      "id": "landcover-wetland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wetland"
      ],
      "paint": {
        "fill-color": "#0F3319",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0,
          11,
          0.6
        ]
      }
    },
    {
      "id": "contour-minor",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": [
        "!=",
        [
          "%",
          [
            "to-number",
            [
              "get",
              "elev"
            ]
          ],
          10
        ],
        0
      ],
      "paint": {
        "line-color": "#2C9A4C",
        "line-width": 0.7,
        "line-opacity": 0.55
      }
    },
    {
      "id": "contour-major",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "filter": [
        "==",
        [
          "%",
          [
            "to-number",
            [
              "get",
              "elev"
            ]
          ],
          10
        ],
        0
      ],
      "paint": {
        "line-color": "#2C9A4C",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.8,
          14,
          1.4
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#040904"
      }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "line-color": "#3DD068",
        "line-width": 1.3
      }
    },
    {
      "id": "waterway-outer",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "river",
          "canal"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#3DD068",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          8,
          2.4,
          14,
          7
        ],
        "line-blur": 0.6
      }
    },
    {
      "id": "waterway-inner",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "river",
          "canal"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#040904",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          8,
          0.8,
          14,
          3.6
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "paint": {
        "line-color": "#2C9A4C",
        "line-width": 1,
        "line-dasharray": [
          2,
          4
        ]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "secondary",
          "tertiary",
          "minor"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0F3319",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.8,
          16,
          2.6
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0F3319",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.5,
          12,
          1.6,
          16,
          4
        ]
      }
    },
    {
      "id": "label-river",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "river"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 13,
        "text-letter-spacing": 0.1,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "#3DD068",
        "text-halo-color": "#040904",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "town"
      ],
      "layout": {
        "text-field": [
          "upcase",
          [
            "coalesce",
            [
              "get",
              "name:latin"
            ],
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10.5,
        "text-letter-spacing": 0.18,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8CFFA6",
        "text-halo-color": "#040904",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "city"
      ],
      "layout": {
        "text-field": [
          "upcase",
          [
            "coalesce",
            [
              "get",
              "name:latin"
            ],
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          10,
          12,
          13
        ],
        "text-letter-spacing": 0.18,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8CFFA6",
        "text-halo-color": "#040904",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    }
  ]
}